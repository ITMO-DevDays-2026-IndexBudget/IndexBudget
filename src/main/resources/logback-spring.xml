<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <!-- pgJDBC may log a complete malformed JDBC URL; the adapter emits safe typed diagnostics. -->
    <logger name="org.postgresql" level="OFF" />
    <root level="WARN">
        <appender-ref ref="STDERR" />
    </root>
</configuration>
