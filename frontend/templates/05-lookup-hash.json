{
  "id": "05-lookup-hash",
  "version": 2,
  "name": "Поиск по строковому ключу",
  "tag": "Hash + B-tree · 16 MiB",
  "description": "Точный поиск и последние записи. При 8 MiB выбирается Hash, при 16 MiB добавляется B-tree для сортировки по времени.",
  "accent": "sand",
  "schema_sql": "CREATE TABLE public.lookup_entries (\n  external_key varchar(160) COLLATE \"C\" NOT NULL,\n  created_at timestamp NOT NULL,\n  payload text NOT NULL\n);",
  "seed_sql": "INSERT INTO public.lookup_entries\nSELECT repeat(md5(i::text), 5),\n       timestamp '2026-01-01 00:00:00' + i * interval '1 second',\n       repeat('x', 160)\nFROM generate_series(1, 200000) AS g(i);",
  "workload": {
    "schema_version": 2,
    "objective": "robust",
    "analysis_mode": "normal",
    "candidate_ranking": "frequency",
    "index_methods": [
      "btree",
      "brin",
      "hash"
    ],
    "queries": [
      {
        "id": "lookup_exact",
        "sql": "SELECT * FROM public.lookup_entries WHERE external_key = 'fe7ecc4de28b2c83c016b5c6c2acd826fe7ecc4de28b2c83c016b5c6c2acd826fe7ecc4de28b2c83c016b5c6c2acd826fe7ecc4de28b2c83c016b5c6c2acd826fe7ecc4de28b2c83c016b5c6c2acd826'"
      },
      {
        "id": "lookup_recent",
        "sql": "SELECT * FROM public.lookup_entries ORDER BY created_at DESC LIMIT 50"
      },
      {
        "id": "lookup_all",
        "sql": "SELECT * FROM public.lookup_entries"
      }
    ],
    "profiles": [
      {
        "id": "lookup",
        "weight": 1,
        "calls_per_hour": {
          "lookup_exact": 1000,
          "lookup_all": 1,
          "lookup_recent": 100
        }
      }
    ],
    "constraints": {
      "storage_budget_bytes": 16777216,
      "write_budget_units_per_hour": 100000,
      "max_indexes": 2
    },
    "table_write_rates": {
      "public.lookup_entries": {
        "inserts_per_hour": 100,
        "updates_per_hour": 10,
        "deletes_per_hour": 5,
        "source": "manual"
      }
    }
  },
  "catalog": {
    "tables": [
      {
        "name": "public.lookup_entries",
        "columns": [
          {
            "name": "external_key",
            "type": "character varying(160)",
            "primary": false,
            "nullable": false
          },
          {
            "name": "created_at",
            "type": "timestamp without time zone",
            "primary": false,
            "nullable": false
          },
          {
            "name": "payload",
            "type": "text",
            "primary": false,
            "nullable": false
          }
        ],
        "rows": 200000,
        "indexes": []
      }
    ],
    "relations": []
  }
}
