    "queries": [
      {
        "id": "records_by_group",
        "sql": "SELECT id, value FROM public.records WHERE group_id = 42 ORDER BY created_at DESC LIMIT 20"
      },
      {
        "id": "records_by_value",
        "sql": "SELECT id, value FROM public.records WHERE value = 7 ORDER BY created_at DESC LIMIT 20"
      },
      {
        "id": "records_recent",
        "sql": "SELECT id, value FROM public.records WHERE created_at >= '2026-01-03 00:00:00'::timestamp ORDER BY created_at DESC LIMIT 20"
      }
    ],
    "profiles": [
